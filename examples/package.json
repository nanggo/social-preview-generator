{
  "name": "social-preview-generator-examples",
  "version": "1.0.0",
  "description": "Example implementations and middleware for Social Preview Generator",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "main": "rate-limiting-server.js",
  "scripts": {
    "start": "node rate-limiting-server.js",
    "dev": "NODE_ENV=development nodemon rate-limiting-server.js",
    "test": "node --test middleware/*.test.js server.test.js",
    "test:redis": "node --test test-redis-rate-limits.js",
    "demo:limits": "node test-rate-limits.js"
  },
  "dependencies": {
    "@nanggo/social-preview": "link:..",
    "express": "^4.18.2",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "pnpm": {
    "overrides": {
      "qs@<6.16.0": "6.16.0"
    }
  },
  "keywords": [
    "social-preview",
    "rate-limiting",
    "middleware",
    "express",
    "redis"
  ],
  "author": "Social Preview Generator",
  "license": "MIT"
}
