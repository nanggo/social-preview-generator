{
  "name": "@nanggo/social-preview",
  "version": "0.6.1",
  "description": "Turn public URLs into secure social preview JPEGs with Node.js",
  "packageManager": "pnpm@10.11.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src",
    "format": "prettier --write 'src/**/*.ts'",
    "verify:actions": "node scripts/verify-action-pins.mjs",
    "verify:dependencies": "node scripts/verify-security-dependency-versions.mjs",
    "verify:fonts": "node scripts/verify-linux-fonts.mjs",
    "verify:package": "node scripts/verify-packed-package.mjs",
    "verify:release": "node scripts/verify-release-contract.mjs",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "keywords": [
    "og-image",
    "open-graph",
    "social-preview",
    "link-preview",
    "thumbnail-generator",
    "meta-tags",
    "social-media"
  ],
  "author": "nanggo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanggo/social-preview-generator.git"
  },
  "bugs": {
    "url": "https://github.com/nanggo/social-preview-generator/issues"
  },
  "homepage": "https://github.com/nanggo/social-preview-generator#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "dompurify": "^3.5.0",
    "file-type": "^22.3.0",
    "jsdom": "^29.1.1",
    "open-graph-scraper": "^6.13.0",
    "sharp": "^0.35.5"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "flatted@<=3.4.1": "3.4.2",
      "nanoid@<3.3.18": "3.3.18",
      "picomatch@>=4.0.0 <4.0.4": "4.0.7",
      "postcss@<=8.5.17": "8.5.18",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "minimatch@>=7.0.0 <11.0.1": "11.0.5"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.11",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@vitest/coverage-v8": "^5.1.2",
    "eslint": "^10.15.0",
    "parse5": "^8.1.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
